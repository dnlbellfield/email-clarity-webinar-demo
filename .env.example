# Keep inactive until every activation prerequisite in docs/BREVO_SETUP.md is approved.
DEMO_SEQUENCE_MODE=inactive
PUBLIC_SITE_URL=http://localhost:8888
DEMO_SEQUENCE_CONFIRM_URL=http://localhost:8888/sequence-confirmed.html?confirmation=brevo
DEMO_SEQUENCE_CONSENT_VERSION=commonlight-demo-v1
DEMO_SEQUENCE_ALLOWED_ORIGINS=http://localhost:8888
DEMO_SEQUENCE_REENTRY_HOURS=24

# Server-side only. Never expose these values in HTML or browser JavaScript.
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_TEMP_LIST_ID=123456
BREVO_CONFIRMED_LIST_ID=123457
DEMO_SEQUENCE_TEST_EMAILS=owner@example.com
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# This key is intentionally public but should still be environment-specific.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Replace with the real Email Clarity inquiry URL before activation.
EMAIL_CLARITY_INQUIRY_URL=https://example.com/inquiry
